# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Local:  postgresql://postgres:postgres@localhost:5432/cloud_erp?schema=public
# Render: postgresql://USER:PASS@HOST/DB?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloud_erp?schema=public"

# JWT — production: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins)
# Local dev: localhost origins are auto-added in development mode
# EC2 prod:  set to http://EC2_PUBLIC_IP or https://yourdomain.com
# See deploy/env/backend.env.example for production template
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Logging
LOG_LEVEL=info
