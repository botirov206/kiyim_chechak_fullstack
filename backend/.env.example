# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Local example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloud_erp?schema=public"
# Render provides DATABASE_URL automatically when linked to a PostgreSQL instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloud_erp?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins; add production frontend URL after deploy)
# Local dev origins (5173, 5174, 3000) are always allowed automatically
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Logging
LOG_LEVEL=info
